# Shell scripts run on Linux (JURECA login nodes, sbatch, this repo's own tooling).
# With core.autocrlf=true a Windows clone would otherwise get CRLF endings, and bash
# then fails on `set -uo pipefail\r` with an error that names nothing useful.
*.sh text eol=lf
*.sbatch text eol=lf

# Notebooks are generated by scripts/nbbuild.py and compared byte-for-byte by
# `nbbuild.py --check`; normalise them so that check is not platform-dependent.
*.ipynb text eol=lf
